---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const games = (await getCollection('games')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Base title="Turn One — quick manuals for tabletop games">
  <h1 class="font-[var(--font-display)] text-3xl font-bold tracking-tight">
    Know enough by turn one.
  </h1>
  <p class="mt-3 max-w-prose text-[var(--color-ink-soft)]">
    Ninety-second guides to tabletop games. Built for the player who has played before
    and needs reminding — and short enough to be useful if you haven't.
  </p>

  <ul class="mt-8 divide-y divide-[var(--color-rule)] border-y border-[var(--color-rule)]" role="list">
    {games.map((game) => (
      <li>
        <a href={`/g/${game.id}`} class="flex items-baseline justify-between gap-4 py-3 no-underline">
          <span class="font-[var(--font-display)] font-semibold">{game.data.title}</span>
          <span class="text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">
            {game.data.category}
          </span>
        </a>
      </li>
    ))}
  </ul>

  {games.length === 0 && (
    <p class="mt-8 text-[var(--color-ink-soft)]">
      No guides yet. Add a YAML file to <code>src/content/games/</code> to get started.
    </p>
  )}

  <p class="mt-6 text-sm text-[var(--color-ink-soft)]">
    {games.length} guide{games.length === 1 ? '' : 's'} so far.
  </p>
</Base>
